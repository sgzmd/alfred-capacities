{
  "name": "alfred-capacities",
  "version": "1.1.0",
  "private": true,
  "description": "Dependency-free Alfred workflow for Capacities quick capture",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "npm run build && bash package.sh",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@capacities/api": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/whatwg-url": "^13.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "plist": "^5.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@kayahr/text-encoding": "^2.0.1",
    "js-sha256": "^0.11.1",
    "mdast-util-to-markdown": "^2.1.2",
    "whatwg-url": "^14.2.0"
  }
}
